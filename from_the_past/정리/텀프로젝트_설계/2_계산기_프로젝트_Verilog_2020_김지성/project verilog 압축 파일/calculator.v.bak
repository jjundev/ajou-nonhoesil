            end   
            'h2000 : begin // '0'을 눌렀을 경우 
               if(sw_status == sw_idle || sw_status == sw_error || sw_status == sw_operator) begin //sw_status 가 sw_idle, sw_error, sw_ operator일 경우
                  sw_status <= sw_s1; 
                  num1_1 <= 20; //null
                  num1_2 <= 20; //null
                  num1_3 <= 20; //null
                  num1_4 <= 20; //null
                  num1_5 <= 20; //null
                  num1_6 <= 0;  // 0 출력
                  num_temp <= 0;
               end else if (sw_status == sw_s1) begin //sw_status 가 sw_s1 일 경우
                  sw_status <= sw_s2; 
                  num1_5 <= num1_6;
                  num1_6 <= 0; 
                  if (num1_6 == 19)
                     num_temp <= 0;
                  else 
                     num_temp <= num1_6 * 10 + 0;
                  
               end else if (sw_status == sw_s2) begin //sw_status 가 sw_s2일 경우
                  sw_status <= sw_s3;
                  num1_4 <= num1_5;
                  num1_5 <= num1_6;
                  num1_6 <= 0;
                  if (num1_5 == 19)
                     num_temp <= -(num1_6 * 10 + 0);
                  else                   
                     num_temp <= num1_5 * 100 + num1_6 * 10 + 0;   
                              
               end else if (sw_status == sw_s3) begin //sw_status가 sw_s3일 경우
                  sw_status <= sw_s4; 
                  num1_3 <= num1_4;
                  num1_4 <= num1_5;
                  num1_5 <= num1_6;
                  num1_6 <= 0; 
                  if (num1_4 == 19)
                     num_temp <= -(num1_5 * 100 + num1_6 * 10 + 0);
                  else
                     num_temp <= (num1_4 * 1000 + num1_5 * 100 + num1_6 * 10 + 0);
                  
               end else if (sw_status == sw_s4) begin //sw_status가  sw_s4일 경우
                  sw_status <= sw_s5;
                  num1_2 <= num1_3;
                  num1_3 <= num1_4;
                  num1_4 <= num1_5;
                  num1_5 <= num1_6;
                  num1_6 <= 0; 
                  if (num1_3 == 19)
                     num_temp <= -(num1_4 * 1000 + num1_5 * 100 + num1_6 * 10 + 0);
                  else
                     num_temp <= num1_3 * 10000 + num1_4 * 1000 + num1_5 * 100 + num1_6 * 10 + 0;   
                  
               end else if (sw_status == sw_s5) begin //sw_status 가 sw_s5일 경우
                  sw_status <= sw_s6; 
                  num1_1 <= num1_2;
                  num1_2 <= num1_3;
                  num1_3 <= num1_4;
                  num1_4 <= num1_5;
                  num1_5 <= num1_6;
                  num1_6 <= 0;      
                  if (num1_2 == 19)
                     num_temp <= -(num1_3*10000 + num1_4 * 1000 + num1_5 * 100 + num1_6 * 10 + 0);
                  else
                     num_temp <= num1_2 * 100000 + num1_3 * 10000 + num1_4 * 1000 + num1_5 * 100 + num1_6 * 10 + 0;   
                     
               end else if (sw_status == sw_s6) begin //sw_status가  sw_s6일 경우
                  sw_status <= sw_error; 
                  num1_1 <= 20; //null
                  num1_2 <= 10; //E
                  num1_3 <= 11; //r
                  num1_4 <= 11; //r
                  num1_5 <= 12; //o
                  num1_6 <= 11; //r 
               end
            end
               
            'h4000 : begin // 'CLEAR'을 눌렀을 경우 
               sw_status <= sw_idle; //sw_status가 sw_idle일 경우 
               num1_1 <= 20; //null
               num1_2 <= 13; //null
               num1_3 <= 14; //null
               num1_4 <= 10; //null
               num1_5 <= 15; //null
               num1_6 <= 11; //null
               cal_result <= 0; //0 대입 
               num_temp <= 0;
            end
            'h8000 : begin // '/'연산을 눌렀을 경우
               if(sw_status==sw_operator && opCurr==3) begin //'/'연산자 두번 눌렀을 경우
                  num1_1 <= 20; //null
                  num1_2 <= 20; //null
                  num1_3 <= 20; //null
                  num1_4 <= 14; //p
                  num1_5 <= 10; //e
                  num1_6 <= 11; //r //percent를 뜻하는 per 출력
                  
                  calc_flag <= 0;      
                  opCurr<=5;
               end else if (sw_status == sw_idle || sw_status == sw_error) begin //sw_status가 sw_idle일 경우
                  sw_status <= sw_error;  //바로 / 누르면 에러
                  num1_1 <= 20; //null
                  num1_2 <= 10; //E
                  num1_3 <= 11; //r
                  num1_4 <= 11; //r
                  num1_5 <= 12; //o
                  num1_6 <= 11; //r 
               end else if (sw_status == sw_operator) begin //sw_status가 sw_operator일 경우 
                  num1_1 <= 20; //null
                  num1_2 <= 20; //null
                  num1_3 <= 20; //null
                  num1_4 <= 20; //null
                  num1_5 <= 20; //null
                  num1_6 <= 18; //'/'연산, 'd'출력
                  calc_flag <= 1;      
                  num_temp <= cal_result;         
                  opPast <= 4;
                  opCurr <= 3; //operator+ 
               end else if (sw_status == sw_equal) begin //sw_status가 sw_equal일 경우
                  sw_status <= sw_operator;
                  num1_1 <= 20; //null
                  num1_2 <= 20; //null
                  num1_3 <= 20; //null
                  num1_4 <= 20; //null
                  num1_5 <= 20; //null
                  num1_6 <= 18; //'/'연산, 'd'출력
                  calc_flag <= 1;
                  num_temp <= cal_result;
                  opPast <= 4;
                  opCurr <= 3;
               end else begin
                  sw_status <= sw_operator;
                  num1_1 <= 20; //null
                  num1_2 <= 20; //null
                  num1_3 <= 20; //null
                  num1_4 <= 20; //null
                  num1_5 <= 20; //null
                  num1_6 <= 18; //'/'연산, 'd'출력
                  calc_flag <= 1;            
                  opPast <= opCurr;
                  opCurr <= 3; //operator / 
               end
            end
               
         endcase
      end
end

