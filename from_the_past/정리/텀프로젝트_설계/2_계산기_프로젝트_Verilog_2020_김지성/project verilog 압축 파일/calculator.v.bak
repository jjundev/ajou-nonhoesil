//fnd_clk <= init_counter(1); // ~2ms clock, 50MHz  7-segmentclock


always @ (num1_1, num1_2, num1_3, num1_4, num1_5, num1_6)
begin
   if(num1_1 == 0)    //num1_1이 0이면 
