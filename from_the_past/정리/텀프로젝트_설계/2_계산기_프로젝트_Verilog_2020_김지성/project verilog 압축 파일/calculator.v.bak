   else if (num1_1 == 1)    //num1_1이 1이면 
      seg_100000 <= 7'b0000110; //seg_100000에 "1"을 출력
   else if (num1_1 == 2)   //num1_1이 2이면
      seg_100000 <= 7'b1011011; //seg_100000에 "2"을 출력, 이후 생략
