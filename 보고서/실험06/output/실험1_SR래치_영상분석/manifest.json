  "scenes": [
    {
      "id": "reset",
      "source_id": "p1",
      "start_s": 0,
      "end_s": 9,
      "item_id": "E6.P1/T1/3",
      "observation": "위 LED 점등, 아래 LED 소등. 두 LED가 가려지지 않은 초기 안정 상태.",
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 1,
          "text": "E=1, S=0, R=1이며 위쪽 Q 프라임이 켜졌다는 설명"
        }
      ],
      "unknowns": [
        "입력값과 위 LED=Q' 대응은 전사본 기준. 실물 LED부터 IC 핀까지 전 구간을 독립 추적하지 못함."
      ]
    },
    {
      "id": "set",
      "source_id": "p1",
      "start_s": 26.9,
      "end_s": 31,
      "item_id": "E6.P1/T1/4",
      "observation": "입력 조작 뒤 위 LED 소등, 아래 LED 점등. 손가락은 아래 LED 근처에 있지만 발광부는 보임.",
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 21,
          "text": "R을 0으로 만든다는 설명"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 24,
          "text": "아래쪽이 켜진다는 설명"
        }
      ],
      "unknowns": [
        "E=1, S=1, R=0은 전사 설명의 연속 문맥 기준. 조작 순간은 손에 가려짐."
      ]
    },
    {
      "id": "hold_enabled",
      "source_id": "p1",
      "start_s": 38,
      "end_s": 44,
      "item_id": "E6.P1/T1/2",
      "observation": "S 조작 뒤 위 LED 소등, 아래 LED 점등 상태가 지속됨.",
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 31,
          "text": "E=1이고 나머지 S와 R은 0, S를 다시 0으로 바꾼다는 설명"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 39,
          "text": "직전 상태를 유지한다는 설명"
        }
      ],
      "unknowns": [
        "S=0 입력은 전사본 기준. 정지 사진 두 장만으로 전체 구간의 연속 유지가 증명되지는 않으며 미리보기와 함께 판단."
      ]
    },
    {
      "id": "hold_disabled",
      "source_id": "p1",
      "start_s": 50,
      "end_s": 58,
      "item_id": "E6.P1/T1/1",
      "observation": "E 조작 이후에도 위 LED 소등, 아래 LED 점등 상태가 지속됨.",
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 44,
          "text": "E도 0으로 바꾼다는 설명"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 48,
          "text": "직전 상태를 유지한다는 설명"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 52,
          "text": "S와 R은 don't care라 바꾸지 않겠다는 설명"
        }
      ],
      "unknowns": [
        "E=0은 전사본 기준. S와 R의 네 조합을 각각 조작한 영상은 없음. 직전 S=R=0 조건을 유지한 사례만 관찰."
      ]
    },
    {
      "id": "failed_final_attempt",
      "source_id": "p1",
      "start_s": 69,
      "end_s": 84.345489,
      "item_id": "E6.P1/T1/5",
      "observation": "최종 입력 설명 뒤 위 LED만 밝게 점등. 아래 LED는 재촬영본과 달리 밝은 발광이 보이지 않음.",
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 69,
          "text": "세 입력이 모두 1이라는 설명"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 81,
          "text": "이게 안 켜진다는 발언"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 83,
          "text": "켜져야 된다는 발언"
        }
      ],
      "unknowns": [
        "실패 원인 미확인. 접촉 불량 또는 배선 수정으로 단정하지 않음."
      ]
    },
    {
      "id": "final_retaken",
      "source_id": "p2",
      "start_s": 0,
      "end_s": 12.248744,
      "item_id": "E6.P1/T1/5",
      "observation": "재촬영 시작부터 위 LED와 아래 LED가 함께 점등. 7초와 11~12초에는 손 가림 없이 두 발광부가 보임.",
      "speech": [
        {
          "source_id": "transcript_p2",
          "at_s": 6,
          "text": "E, S, R이 전부 1인 경우라는 설명"
        },
        {
          "source_id": "transcript_p2",
          "at_s": 8,
          "text": "아래쪽과 위쪽 모두 들어온다는 설명"
        },
        {
          "source_id": "transcript_p2",
          "at_s": 11,
          "text": "두 개 다 들어왔다는 설명"
        }
      ],
      "unknowns": [
        "두 촬영 사이의 조치·원인은 영상과 전사에 없음. 연속 전이 성공이 아닌 재촬영 최종 상태의 근거."
      ]
    }
  ],
