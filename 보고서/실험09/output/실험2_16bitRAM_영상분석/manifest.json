      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 0.7,
          "text": "쓴 상태."
        },
        {
          "source_id": "transcript_p1",
          "at_s": 39.1,
          "text": "그럼 주소 01에 다가 쓰는 과정을 진행"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 54.4,
          "text": "주소를 10으로 바꾼다"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 101.0,
          "text": "다시 쓰기 모드로 해서 11로 바꾼다"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 143.8,
          "text": "다시 올리면 쓰기 끝."
        }
      ],
      "observation": "쓰기 동안 LED 네 개 모두 소등. 손이 회로를 자주 가림",
      "unknowns": [
        "주소 00 쓰기(W1)는 촬영 시작 전에 끝났다는 발언뿐",
        "WB·WA·D·WE 스위치 값은 화면으로 확인 못함"
      ]
    },
    {
      "id": "read00",
      "source_id": "p1",
      "start_s": 150,
      "end_s": 172,
      "item_id": "E9.P2/T4/R1",
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 148.4,
          "text": "지금부터 읽어 보겠습니다."
        },
        {
          "source_id": "transcript_p1",
          "at_s": 155.5,
          "text": "q1이 켜지고"
        }
      ],
      "observation": "156~170초 맨 위(1번째) LED만 점등",
      "unknowns": [
        "LED 위치와 Q1~Q4 핀 대응은 배선 추적으로 확인 못함"
      ]
    },
    {
      "id": "read01",
