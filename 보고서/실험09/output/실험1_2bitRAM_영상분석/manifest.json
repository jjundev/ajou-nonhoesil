  "scenes": [
    {
      "id": "a_write_read",
      "source_id": "p1",
      "start_s": 0,
      "end_s": 40,
      "item_id": "E9.P1/T1/R1",
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 1.2,
          "text": "인 제로를 5볼트로 올리고요"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 8.0,
          "text": "인제로를 다시 그라운드로 내린 다음 … 오이 제로를 5볼트로"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 30.3,
          "text": "그러면 위에가 켜지는 게 맞죠?"
        }
      ],
      "observation": "33~37초 위 LED 점등, 아래 LED 소등. 40초에는 둘 다 소등",
      "unknowns": [
        "LED와 OUT 핀의 대응은 배선을 따라 확인하지 못함(위=A·OUT0, 아래=B·OUT1 은 발언 기준 추정)",
        "스위치 위치(입력값)는 화면으로 확인하지 못함, 발언 기준"
      ]
    },
    {
      "id": "b_write0",
      "source_id": "p1",
      "start_s": 40,
      "end_s": 125,
      "item_id": "E9.P1/T1/W2",
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 53.6,
          "text": "더블유 인 제로가 6 발이니까 얘를 1로 바꾸고 … 더블유 알 원을 그라운드로"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 98.3,
          "text": "얘를 그러면 아무것도 안 켜지는 상태고"
        }
      ],
      "observation": "105~120초 두 LED 모두 소등",
      "unknowns": [
        "전사의 '인 제로·아이 알 원' 등 신호 이름은 자동 전사 표기이며 실제 조작 스위치는 화면으로 확인 못함"
      ]
    },
    {
      "id": "b_read0",
      "source_id": "p1",
      "start_s": 125,
      "end_s": 150,
      "item_id": "E9.P1/T1/R2",
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 136.4,
          "text": "그럼 위에만 켜지는 상태가 지금 맞고요"
        }
      ],
      "observation": "128~145초 위 LED 점등, 아래 LED 소등",
      "unknowns": [
        "LED와 OUT 핀의 대응은 배선을 따라 확인하지 못함(위=A·OUT0, 아래=B·OUT1 은 발언 기준 추정)"
      ]
    },
    {
      "id": "wire_reseat",
      "source_id": "p1",
      "start_s": 150,
      "end_s": 176,
      "item_id": null,
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 161.3,
          "text": "이거 선 빠진 거 아니죠?"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 166.8,
          "text": "아, 빠졌어."
        }
      ],
      "observation": "155~172초 손이 회로 위에서 선을 다시 꽂는 동작. 어느 선이 빠졌는지는 화면에서 판독 못함",
      "unknowns": [
        "빠진 선의 위치·넷과, 빠진 시점이 R2 판독 전인지 후인지 미확인"
      ]
    },
    {
      "id": "b_write1_read",
      "source_id": "p1",
      "start_s": 176,
      "end_s": 225,
      "item_id": "E9.P1/T1/R3",
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 169.6,
          "text": "그라운드로 놓고 더블유 알 원을 5볼트로 바꾼 뒤"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 193.0,
          "text": "그럼 안 켜지는 상태가 맞고 아이 알 원을 내려서 저장한 다음에 오이 제로 오이 1을 … 올리면"
        }
      ],
      "observation": "180~196초 두 LED 소등, 202~218초 두 LED 모두 점등",
      "unknowns": [
        "LED와 OUT 핀의 대응은 배선을 따라 확인하지 못함(위=A·OUT0, 아래=B·OUT1 은 발언 기준 추정)",
        "선 재연결 직후라 W3 이전 상태와의 연속성은 끊김"
      ]
    },
    {
      "id": "a_write0_read",
      "source_id": "p1",
      "start_s": 225,
      "end_s": 272.7,
      "item_id": "E9.P1/T1/R4",
      "speech": [
        {
          "source_id": "transcript_p1",
          "at_s": 210.5,
          "text": "오이 제로 오이 1을 내리고 … 더블유 알 제로를 5볼트 … 더블유 알 원을"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 234.1,
          "text": "그라운드로 바꾸고 아이 인 제로를 1로 올려요"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 244.9,
          "text": "아이 인 제로를 내려서 저장을 하고 오이 제로 오이 1을 올려"
        },
        {
          "source_id": "transcript_p1",
          "at_s": 268.8,
          "text": "비가 켜지는 것으로 실험이 끝이 납니다"
        }
      ],
      "observation": "236~248초 두 LED 소등, 260~272초 아래 LED만 점등",
      "unknowns": [
        "LED와 OUT 핀의 대응은 배선을 따라 확인하지 못함(위=A·OUT0, 아래=B·OUT1 은 발언 기준 추정)"
      ]
    }
